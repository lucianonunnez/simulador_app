# Copiar a .env y completar. El archivo .env no se versiona.

# Usuario de acceso a la app (se genera el secrets.toml al arrancar el contenedor).
SIMULADOR_USER=admin
SIMULADOR_PASSWORD=
SIMULADOR_NAME=Administrador
# Opcional: fijarla evita que las sesiones se invaliden al reiniciar el contenedor.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SIMULADOR_COOKIE_KEY=

# true = si no hay base, genera un dataset sintético al arrancar.
DEMO_DATA=true

# Opcional: fuente de datos PostgreSQL/Supabase en lugar de DuckDB local.
# SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres
# SUPABASE_SCHEMA=simulador

# Opcional: servir bajo un subpath (ej. detrás de un ingress en /simulador).
# STREAMLIT_SERVER_BASE_URL_PATH=simulador
